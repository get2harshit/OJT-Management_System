# Loaded by `npm run dev` (Vite's default mode when serving), and by nothing
# else — image builds pass --mode staging or --mode production explicitly.
#
# These are the staging addresses, which is what local development has always
# talked to. They used to be hardcoded as `||` fallbacks in lib/api/client.ts
# and lib/googleAuth.ts; the fallback is what let a production build with a
# missing variable come out pointed at staging and look completely fine. Having
# them here instead means the dev convenience survives while a deployed build
# with a missing variable now fails instead of quietly working.
#
# .env.local overrides this file and is gitignored — put a local backend there:
#   VITE_API_BASE_URL=http://localhost:8080
#
# Not secrets. Both are addresses the browser is sent to and ship in the bundle.

VITE_API_BASE_URL=https://ojt-system-be-672553132888.asia-south1.run.app
VITE_SUPABASE_URL=https://cumeeqozfrnehtjivirf.supabase.co
