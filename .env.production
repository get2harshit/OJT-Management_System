# Baked into the bundle by `vite build --mode production` (the default mode for
# `vite build`, so this is what a build with no --mode produces).
#
# NOT SAFE TO DEPLOY YET. Production is currently served by a bundle that calls
# the staging backend, and everything real — cohorts, students, mentors, tasks —
# lives in the staging database. The production database has the 35 tables but
# every one of them is empty, and they sit in an `ojt_system` schema while the
# backend still asks for `public`. Deploying this file today would take
# production from working-on-staging-data to working-on-nothing.
#
# Before the main branch is allowed to deploy: move the schema, populate the
# production database, and decide what happens to the accounts that exist in
# the staging Supabase project but not the production one.
#
# Not secrets. Both are addresses the browser is sent to and ship in every build.

VITE_API_BASE_URL=https://ojt-system-be-prod-672553132888.asia-south1.run.app

# Derived from the production database host (db.<ref>.supabase.co). Confirm it
# against the Supabase dashboard before this is ever deployed — it decides whose
# auth.users people are signed in against, and the two projects are separate.
VITE_SUPABASE_URL=https://zkvjvypydiyfblrrguuv.supabase.co
