# Baked into the bundle by `vite build --mode production` (the default mode for
# `vite build`, so this is what a build with no --mode produces).
#
# Deploying this is a cutover, not a deploy. Production is served today by a
# bundle that calls the staging backend, so everything real — cohorts, students,
# mentors, tasks — lives in the staging database. The moment an image built from
# this file goes out, production starts reading the production database instead:
# a separate database, with its own 35 tables in an `ojt_system` schema.
#
# Two things do not follow the switch on their own:
#   - Application data has to be put into the production database. Empty tables
#     do not error, they just show an app with nothing in it.
#   - Accounts are not application data. They live in the Supabase project named
#     below, and staging and production are separate projects with separate
#     auth.users. After the switch people sign in against a different set.
#
# Not secrets. Both are addresses the browser is sent to and ship in every build.

VITE_API_BASE_URL=https://ojt-system-be-prod-672553132888.asia-south1.run.app

# Confirmed against the production database host (db.zkvjvypydiyfblrrguuv
# .supabase.co) — same project ref, so this is the project that owns production's
# auth.users. The backend must be given the matching SUPABASE_URL,
# SUPABASE_SERVICE_ROLE_KEY and SUPABASE_JWT_SECRET for this project: if it is
# still holding staging's JWT secret it will reject every token this project
# issues, and the symptom is a correct password followed by 401.
VITE_SUPABASE_URL=https://zkvjvypydiyfblrrguuv.supabase.co
