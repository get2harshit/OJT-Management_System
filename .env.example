# Copy to .env.local and uncomment to point the frontend at your local backend
# (the OJT-system-BE repo, default port 8080) instead of the production API.
# VITE_API_BASE_URL=http://localhost:8080

# The Supabase project the backend authenticates against — the same value as
# SUPABASE_URL in OJT-system-BE/.env. Not a secret: it is the address the
# browser is sent to, and it ships in every build.
#
# Setting this is what makes the "Continue with Google" button appear. Left
# unset the button is hidden rather than shown broken, because an origin that
# is not on the Supabase project's redirect allow-list sends people to Google
# and bounces them back with an error — which reads as the feature failing
# rather than as it never having been switched on.
# VITE_SUPABASE_URL=https://your-project.supabase.co
